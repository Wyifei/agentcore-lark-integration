{
  "name": "sample-agentcore-lark-integration",
  "version": "0.5.1",
  "license": "MIT-0",
  "private": true,
  "description": "Sample: connect Strands agents on Amazon Bedrock AgentCore to Feishu/Lark",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agentcore-chat-bridge": "dist/afb.mjs"
  },
  "scripts": {
    "dev": "AFB_DATA_DIR=${AFB_DATA_DIR:-./.data} AFB_DEV=1 node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts serve",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "release": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/release.ts",
    "deploy": "npm run release && npm --prefix infra run cdk -- deploy",
    "cli": "AFB_DATA_DIR=${AFB_DATA_DIR:-./.data} AFB_DEV=1 node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore-control": "3.1162.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1162.0",
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/client-secrets-manager": "3.1162.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/qrcode-terminal": "0.12.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
