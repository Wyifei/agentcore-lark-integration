# /usr/local/bin/agentcore-chat-bridge: wrapper script for humans (design 4.7). /usr/local/bin/agentcore-feishu-bot is a compatibility link that points to it.
#   update            → sudo afb-update (root, no arguments)
#   restart / logs    → sudo systemctl restart / tail -F
#   other subcommands → sudo -u afbot afb <subcommand>; exit code 100 means a reload is needed
set -u
readonly SERVICE=agentcore-feishu-bot
readonly AFB=/opt/agentcore-feishu-bot/bin/afb
readonly LOG=/var/log/agentcore-feishu-bot/serve.log
readonly EXIT_NEEDS_RELOAD=100

case "${1:-}" in
  update)
    if [ $# -ne 1 ]; then echo "update 不接受参数（版本号运行时交互输入）" >&2; exit 2; fi
    exec sudo /opt/agentcore-feishu-bot/bin/afb-update ;;
  restart)
    exec sudo /usr/bin/systemctl restart "$SERVICE" ;;
  logs)
    exec tail -F "$LOG" ;;
  serve)
    echo "serve 由 systemd 运行，请用 agentcore-chat-bridge restart" >&2; exit 2 ;;
esac

sudo -u afbot "$AFB" "$@"
rc=$?
if [ "$rc" -eq "$EXIT_NEEDS_RELOAD" ]; then
  if systemctl is-active --quiet "$SERVICE"; then
    sudo /usr/bin/systemctl reload "$SERVICE" && echo "已通知服务重新加载配置。"
    exit $?
  fi
  echo "服务未运行。运行 agentcore-chat-bridge restart 启动。"
  exit 0
fi
exit "$rc"
